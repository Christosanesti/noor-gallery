generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String       @id @default(cuid())
  nameFa      String
  slug        String       @unique
  order       Int          @default(0)
  collections Collection[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Collection {
  id            String         @id @default(cuid())
  titleFa       String
  slug          String         @unique
  descriptionFa String         @db.Text
  excerptFa     String?
  featured      Boolean        @default(false)
  published     Boolean        @default(false)
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images        GalleryImage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model GalleryImage {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  url          String
  blobPath     String
  altFa        String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
}

model SiteSettings {
  id             String   @id @default("singleton")
  heroTitleFa    String
  heroSubtitleFa String?
  aboutFa        String   @db.Text
  addressFa      String?
  phone          String?
  instagram      String?
  whatsapp       String?
  updatedAt      DateTime @updatedAt
}
